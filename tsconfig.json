{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@greenproof/shared": ["packages/shared/src"],
      "@greenproof/shared/*": ["packages/shared/src/*"]
    }
  },
  "include": ["apps/**/*", "packages/**/*"]
}
